# database
# Database is named by student index number (IB210059) without the IB prefix, per spec 3.1.
_saPassword=YourSqlPassword!
_source=sqlserver
_catalog=210059
# SQL Server port, used when the API runs outside Docker (inside Docker the connection string is built by docker-compose)
_sqlPort=1433

# rabbitmq
_rabbitMqHost=rabbitmq
_rabbitMqUser=guest
_rabbitMqPassword=guest
_rabbitMqPort=5672

# redis (used by the recommender for cached doctor rankings; safe to leave empty -> falls back to no cache)
Redis__ConnectionString=redis:6379

# email -- leave _fromAddress / _password empty to make the Worker log instead of sending
_fromAddress=
_password=
_host=smtp.gmail.com
_enableSSL=true
_displayName=eDoktor
_timeout=30000
_port=587

# API host settings
# Browser origins allowed to call the API (comma-separated; e.g. the admin app when run as a web app)
Cors__AllowedOrigins=http://localhost:5190,http://127.0.0.1:5190,http://localhost:8088
# Swagger UI at /swagger (API documentation)
Swagger__Enabled=true
# Time zone used for times written in notifications and emails (data is stored in UTC)
App__TimeZone=Europe/Sarajevo
# Jitsi server used for online consultations
VideoCall__BaseUrl=https://meet.jit.si

# JWT -- key must be at least 32 ASCII bytes long
Jwt__Issuer=eDoktor
Jwt__Audience=eDoktor
Jwt__Key=please-replace-with-a-long-random-secret-at-least-32-bytes-long
Jwt__ExpiryMinutes=1440

# PayPal Sandbox -- create credentials at https://developer.paypal.com
PayPal__ClientId=
PayPal__ClientSecret=
PayPal__BaseUrl=https://api-m.sandbox.paypal.com
PayPal__Currency=EUR
PayPal__WebhookId=
# PayPal redirects here after approve/cancel; the mobile app intercepts these URLs inside its WebView.
PayPal__ReturnUrl=https://edoktor.app/paypal/return
PayPal__CancelUrl=https://edoktor.app/paypal/cancel
