# RabbitMQ Configuration
_rabbitMqHost=localhost
_rabbitMqUser=guest
_rabbitMqPassword=guest
_rabbitMqPort=5672

# Email Configuration
# Leave _fromAddress / _password empty to make the Worker log emails to the console instead of sending.
_fromAddress=
_password=
_host=smtp.gmail.com
_enableSSL=true
_displayName=eDoktor
_timeout=30000
_port=587
